<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kuida_surface">

    <!-- Las 3 piezas del K se superponen alineadas (mismo viewport 108)
         y vuelan desde los bordes hasta ensamblar el logo -->
    <FrameLayout
        android:id="@+id/splash_logo_box"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/splash_piece_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:src="@drawable/splash_piece_bar" />

        <ImageView
            android:id="@+id/splash_piece_chevron"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:src="@drawable/splash_piece_chevron" />

        <ImageView
            android:id="@+id/splash_piece_smile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:src="@drawable/splash_piece_smile" />

    </FrameLayout>

</FrameLayout>
